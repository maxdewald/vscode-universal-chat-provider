{
  "publisher": "maxdewald",
  "name": "universal-chat-provider",
  "displayName": "Universal Chat Provider",
  "type": "module",
  "version": "1.2.0",
  "packageManager": "pnpm@12.6.0",
  "volta": {
    "node": "24.21.0",
    "pnpm": "12.6.0"
  },
  "description": "Claude, Codex, Antigravity & more in GitHub Copilot Chat. No API key, just OAuth.",
  "author": "Maximilian Dewald <maximilian@dewald.one>",
  "license": "MIT",
  "homepage": "https://github.com/maxdewald/vscode-universal-chat-provider#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxdewald/vscode-universal-chat-provider.git"
  },
  "bugs": {
    "url": "https://github.com/maxdewald/vscode-universal-chat-provider/issues"
  },
  "keywords": [
    "language-models"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/index.cjs",
  "icon": "images/logo.png",
  "files": [
    "LICENSE.md",
    "dist/*",
    "images/logo.png"
  ],
  "engines": {
    "node": ">=22.18.0",
    "vscode": "^1.131.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "universal-chat-provider",
        "displayName": "Universal Chat Provider",
        "managementCommand": "universalChatProvider.login"
      }
    ],
    "commands": [
      {
        "command": "universalChatProvider.manage",
        "title": "Universal Chat Provider: Manage Provider"
      },
      {
        "command": "universalChatProvider.login",
        "title": "Universal Chat Provider: Add Account (Login)"
      },
      {
        "command": "universalChatProvider.manageAccounts",
        "title": "Universal Chat Provider: Manage Accounts"
      },
      {
        "command": "universalChatProvider.showQuota",
        "title": "Universal Chat Provider: Show Quota & Resets"
      },
      {
        "command": "universalChatProvider.restartServer",
        "title": "Universal Chat Provider: Restart Managed Server"
      },
      {
        "command": "universalChatProvider.updateBinary",
        "title": "Universal Chat Provider: Update Proxy Binary"
      },
      {
        "command": "universalChatProvider.resetServer",
        "title": "Universal Chat Provider: Reset Managed Server"
      },
      {
        "command": "universalChatProvider.configure",
        "title": "Universal Chat Provider: Configure Connection"
      },
      {
        "command": "universalChatProvider.refresh",
        "title": "Universal Chat Provider: Refresh Models"
      },
      {
        "command": "universalChatProvider.setUtilityModel",
        "title": "Universal Chat Provider: Set Utility Model (commit messages, chat titles, summaries)"
      },
      {
        "command": "universalChatProvider.clearCredentials",
        "title": "Universal Chat Provider: Clear Stored API Key"
      },
      {
        "command": "universalChatProvider.showLogs",
        "title": "Universal Chat Provider: Show Logs"
      },
      {
        "command": "universalChatProvider.showServerLogs",
        "title": "Universal Chat Provider: Show Server Output"
      },
      {
        "command": "universalChatProvider.openSettings",
        "title": "Universal Chat Provider: Open Settings"
      }
    ],
    "configuration": [
      {
        "type": "object",
        "title": "Connection",
        "order": 1,
        "properties": {
          "universalChatProvider.server.mode": {
            "type": "string",
            "enum": [
              "managed",
              "external"
            ],
            "enumItemLabels": [
              "Managed",
              "External"
            ],
            "enumDescriptions": [
              "Download and run CLIProxyAPI automatically.",
              "Connect to a CLIProxyAPI server you run yourself."
            ],
            "default": "managed",
            "order": 1,
            "description": "How to run CLIProxyAPI."
          },
          "universalChatProvider.baseUrl": {
            "type": "string",
            "default": "http://127.0.0.1:8317",
            "order": 2,
            "description": "URL of your CLIProxyAPI server. External mode only.",
            "markdownDescription": "URL of your CLIProxyAPI server. Only used when `#universalChatProvider.server.mode#` is External."
          },
          "universalChatProvider.server.managementKey": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "order": 5,
            "description": "Management key of your CLIProxyAPI server (the plain key, not its hash). External mode only."
          }
        }
      },
      {
        "type": "object",
        "title": "Managed Server",
        "order": 2,
        "properties": {
          "universalChatProvider.server.updatePolicy": {
            "type": "string",
            "enum": [
              "automatic",
              "suggestUpdates",
              "manual"
            ],
            "enumItemLabels": [
              "Automatic",
              "Suggest Updates",
              "Manual"
            ],
            "markdownEnumDescriptions": [
              "Update on startup and restart once no requests are running.",
              "Ask before installing updates.",
              "Stay on `#universalChatProvider.server.version#` and never check for updates."
            ],
            "default": "automatic",
            "scope": "machine",
            "order": 1,
            "description": "How the managed server is updated."
          },
          "universalChatProvider.server.version": {
            "type": "string",
            "default": "latest",
            "scope": "machine",
            "order": 2,
            "description": "CLIProxyAPI version for Manual updates: latest or an exact version (8.0.3 or newer).",
            "markdownDescription": "CLIProxyAPI version used when `#universalChatProvider.server.updatePolicy#` is Manual: `latest` or an exact version (8.0.3 or newer)."
          },
          "universalChatProvider.server.extraConfig": {
            "type": "string",
            "default": "# requests:\n#   proxy-url: http://127.0.0.1:7890\n# routing:\n#   strategy: fill-first\n#   retry:\n#     request-retry: 3",
            "scope": "machine",
            "editPresentation": "multilineText",
            "order": 3,
            "description": "Extra YAML config for the managed server, such as proxy, retries, and account selection. Changing connection, credential, or provider settings can break the extension.",
            "markdownDescription": "Extra YAML config for the managed server. See the [configuration reference](https://github.com/router-for-me/CLIProxyAPI/blob/main/config.example.yaml).\n\n**Examples**\n- `requests.proxy-url`: upstream proxy\n- `routing.retry.request-retry`: retry count\n- `routing.strategy`: account selection (`round-robin` or `fill-first`)\n\nChanging connection, credential, or provider settings can break the extension."
          }
        }
      },
      {
        "type": "object",
        "title": "Status Bar",
        "order": 3,
        "properties": {
          "universalChatProvider.showQuotaWarnings": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "description": "Warn in the status bar when the current model is low on quota."
          },
          "universalChatProvider.quotaWarningThreshold": {
            "type": "number",
            "default": 10,
            "minimum": 0,
            "maximum": 100,
            "order": 2,
            "description": "Warn when remaining quota drops below this percentage."
          }
        }
      },
      {
        "type": "object",
        "title": "Models",
        "order": 4,
        "properties": {
          "universalChatProvider.models.showLatestOnly": {
            "type": "boolean",
            "default": false,
            "order": 1,
            "description": "Hide older versions of a model when a newer one is available, e.g. Claude Opus 4.8 once Opus 5.5 is out."
          }
        }
      },
      {
        "type": "object",
        "title": "Provider Specific",
        "order": 5,
        "properties": {
          "universalChatProvider.codex.webSearch": {
            "type": "boolean",
            "default": false,
            "description": "Let Codex search and browse the web."
          },
          "universalChatProvider.claude.webSearch": {
            "type": "boolean",
            "default": false,
            "description": "Let Claude search the web."
          }
        }
      },
      {
        "type": "object",
        "title": "Advanced",
        "order": 6,
        "properties": {
          "universalChatProvider.debugLevel": {
            "type": "string",
            "enum": [
              "off",
              "diagnostics",
              "requestLogging"
            ],
            "enumItemLabels": [
              "Off",
              "Diagnostics",
              "Request Logging"
            ],
            "enumDescriptions": [
              "Collect nothing.",
              "Show prompt cache stats and save redacted request details.",
              "Also save full requests and responses. These may contain prompts, files, and credentials. Restarts the managed server."
            ],
            "default": "off",
            "order": 1,
            "description": "How much diagnostic data to collect."
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --sourcemap",
    "prepare": "pnpm generate",
    "generate": "vscode-ext-gen --output src/generated/meta.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:compat": "UCP_COMPAT_TESTS=1 vitest run test/chat/requests/compaction.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "vscode:prepublish": "pnpm build",
    "ext:package": "vsce package --no-dependencies",
    "ext:publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "eventsource-parser": "^4.0.0",
    "fflate": "^0.8.3",
    "file-type": "^22.0.1",
    "get-port": "^7.2.0",
    "ky": "^2.0.2",
    "moderndash": "^4.0.2",
    "nanotar": "^0.3.0",
    "semver": "^7.8.4",
    "tokenx": "^2.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@dword-design/eslint-plugin-import-alias": "^8.1.8",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.13.2",
    "@types/semver": "^7.7.1",
    "@types/vscode": "^1.125.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.12.0",
    "jest-mock-vscode": "^4.12.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vscode-ext-gen": "^1.6.0"
  }
}
